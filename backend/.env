# CareerConnect Environment Configuration
APP_NAME=CareerConnect
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL supported; SQLite default for instant dev & test)
DATABASE_URL=sqlite:///./careerconnect.db

# Authentication & Security
SECRET_KEY=careerconnect-super-secure-production-ready-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

PASSWORD_RESET_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=*

UPLOAD_DIR=./uploads/resumes
MAX_UPLOAD_SIZE_MB=10

# External Job Providers Configuration
ENABLE_REMOTIVE=True
ENABLE_ARBEITNOW=True
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

FCM_SERVER_KEY=
