# CareerConnect Environment Configuration

# Server Settings
APP_NAME=CareerConnect
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration
# For production PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerconnect_db
# For local development/testing without PostgreSQL service:
# DATABASE_URL=sqlite:///./careerconnect.db

# Authentication & Security
SECRET_KEY=careerconnect-super-secure-production-ready-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Reset Token Expiry (Minutes)
PASSWORD_RESET_EXPIRE_MINUTES=30

# CORS Allowed Origins (Comma separated or * for dev)
ALLOWED_ORIGINS=*

# Resume Upload Configuration
UPLOAD_DIR=./uploads/resumes
MAX_UPLOAD_SIZE_MB=10

# External Job Providers Configuration
# Remotive (Free public API, no key required)
ENABLE_REMOTIVE=True
# Arbeitnow (Free public API, no key required)
ENABLE_ARBEITNOW=True
# Adzuna API (Optional, requires free API keys from developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Firebase Cloud Messaging (Optional for push notifications)
FCM_SERVER_KEY=
